<?xml version="1.0" encoding="utf-8"?>
<!--
  This variant used to remove READ_PHONE_STATE / READ_EXTERNAL_STORAGE / WRITE_EXTERNAL_STORAGE,
  which old versions of libadb used to pull in (it targeted SDK 1). libadb-android 3.1.0 declares
  only INTERNET, so the manifest merger reports "no other declaration present" for each removal and
  there is nothing left to remove. Add a tools:node="remove" entry here again if a dependency starts
  declaring a permission we do not want.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools" />
